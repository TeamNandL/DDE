# Copy to .env (never commit .env). Existing process env wins over this file.
#
# Test 9 / rented Postgres (Supabase project dde-vault):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
#
# Optional HTTP BFF:
# PORT=8787
# HOST=127.0.0.1
#
# Container / Fly / Render (the Docker image sets these):
# HOST=0.0.0.0
# NODE_ENV=production
# Never put DATABASE_URL in a committed file.
